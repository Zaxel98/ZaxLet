<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Version>1.3.0</Version>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>ZaxLet</AssemblyName>
    <RootNamespace>ZaxLet</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\zaxlet.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- save RAM: non-concurrent GC + memory conservation. InvariantGlobalization is NOT used: WPF fails to type without keyboard culture -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <!-- without a cap, gen-0 budget tracks CPU cache and GC holds onto tens of empty MB -->
    <RuntimeHostConfigurationOption Include="System.GC.Gen0MaxBudget" Value="4194304" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="Concentus" Version="2.2.3" />
  </ItemGroup>

</Project>
