<Window x:Class="ZaxLet.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZaxLet" Width="720" Height="460"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <!-- Pill: bentuk "notch" dengan bahu cekung di atas (digambar di kode), isi di atasnya -->
        <Grid x:Name="Pill" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Top"
              Width="220" Height="36" AllowDrop="True">
            <Path x:Name="Shape" Fill="Black" Margin="-12,0,-12,0"/>
            <Grid x:Name="IdleLayer">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid x:Name="IdleRow" Margin="14,0,14,0" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="ZoneL" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <StackPanel x:Name="ZoneC" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <StackPanel x:Name="ZoneR" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Row="1" Margin="18,0,18,0" VerticalAlignment="Top">
                    <!-- notifikasi HP: satu baris per notifikasi (terbaru di atas), digulir bila lebih banyak dari batas -->
                    <Grid x:Name="NotifHost" Visibility="Collapsed">
                        <ScrollViewer x:Name="NotifScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False" Background="Transparent">
                            <StackPanel x:Name="NotifRows"/>
                        </ScrollViewer>
                        <TextBlock x:Name="NotifMore" FontSize="10.5" FontWeight="SemiBold" Foreground="#99FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,0,0" IsHitTestVisible="False"/>
                    </Grid>
                    <Grid x:Name="Row2Host">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image x:Name="Row2Icon" Width="16" Height="16" Margin="0,1,7,0" Visibility="Collapsed" VerticalAlignment="Top"/>
                    </Grid>
                </StackPanel>
            </Grid>
            <Grid x:Name="OpenLayer" Visibility="Collapsed" Opacity="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="46"/>
                </Grid.RowDefinitions>
                <Grid x:Name="Host" ClipToBounds="True"/>
                <Border Grid.Row="1" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Margin="14,0">
                    <StackPanel x:Name="TabBar" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
